# Copy to .env.local for local overrides (gitignored).
# Copy to .env.production and fill in real values before building for prod.

# Full base URL of the API, including /v1 suffix.
# Leave as /api/v1 when using the Vite dev proxy.
VITE_API_BASE_URL=/api/v1

# Bearer token sent as Authorization header (optional).
VITE_API_KEY=

# GCP resource cache TTL in milliseconds.
# 300000 = 5 minutes, 600000 = 10 minutes.
VITE_CACHE_TTL_MS=300000

# Comma-separated GCP project IDs for the Firewall page.
# Supports optional labels: "Label:project-id,Label:project-id"
# Example: NPRD:my-nprd-infra-shared,PROD:my-prod-infra-shared
VITE_FIREWALL_PROJECTS=
