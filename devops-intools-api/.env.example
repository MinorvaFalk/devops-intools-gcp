# ─── Server ─────────────────────────────────────────────────────────────────
PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=120s
CORS_ORIGIN=*

# ─── GCP ────────────────────────────────────────────────────────────────────
# Path to your service account JSON key. Project IDs are no longer baked into
# config — call GET /api/v1/projects to discover them, then pass ?project=...
# on every other request. Region/zone are also passed per-request via
# ?zone=... / ?location=... query params.
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Auth ───────────────────────────────────────────────────────────────────
# Leave API_KEY empty to disable bearer-token auth. When set, every request
# (except /health and /readyz) must include "Authorization: Bearer <key>".
API_KEY=
ENABLE_IAP=false
IAP_AUDIENCE=

# ─── Logging ────────────────────────────────────────────────────────────────
# LOG_FORMAT: console (color, dev-friendly) | json (production)
# LOG_LEVEL:  debug | info | warn | error
LOG_LEVEL=info
LOG_FORMAT=console
DATABASE_URL=postgres://devtools:devtools@localhost:5432/devtools?sslmode=disable

# ─── Project Reference API ──────────────────────────────────────────────────
# Full URL of the project registry API endpoint (including path and query params).
# Example: https://registry.internal/api/projects/?format=json
PROJECT_REF_URL=
# Set to true if the project ref API uses a self-signed certificate.
PROJECT_REF_SKIP_TLS_VERIFY=false
