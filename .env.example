# Copy to .env and fill in values before running docker compose up.
#
# Development:
#   docker compose up --build
#
# Production:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=devtools
POSTGRES_PASSWORD=devtools
POSTGRES_DB=devtools

# ── GCP ───────────────────────────────────────────────────────────────────────
# Absolute path to your service account JSON key on the host machine.
GCP_CREDENTIALS_FILE=/path/to/service-account.json

# ── API ───────────────────────────────────────────────────────────────────────
# Bearer token for the API (leave empty to disable auth).
API_KEY=

# GCP IAP validation (optional).
ENABLE_IAP=false
IAP_AUDIENCE=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Allowed CORS origin(s).
CORS_ORIGIN=*

# Base URL of the external project registry API (optional).
EXTERNAL_API_URL=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Host port the app will be available on.
APP_PORT=3000

# Bearer token passed to the frontend (usually matches API_KEY).
VITE_API_KEY=

# GCP resource cache TTL in milliseconds (default 5 min).
VITE_CACHE_TTL_MS=300000

# Comma-separated firewall VPC projects. Supports "Label:project-id" pairs.
# Example: NPRD:my-nprd-infra-shared,PROD:my-prod-infra-shared
VITE_FIREWALL_PROJECTS=

# ── Production image registry (docker-compose.prod.yml only) ──────────────────
# Container registry hostname (e.g. docker.io, ghcr.io, asia-southeast1-docker.pkg.dev)
REGISTRY=docker.io
# Namespace / repository prefix under the registry
IMAGE_NS=devops-intools
# Image tag to pull/push (e.g. latest, v1.2.0, git SHA)
TAG=latest
